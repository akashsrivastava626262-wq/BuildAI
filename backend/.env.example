# Server
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# Database (PostgreSQL)
DATABASE_URL=postgresql://buildflow:buildflow_secret@localhost:5432/buildflow?schema=public

# JWT Authentication
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# Stripe Payment Processing
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CURRENCY=inr

# Email (SMTP — works with Gmail, SendGrid SMTP, Mailtrap, etc.)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=BuildFlow <noreply@buildflow.ai>
ADMIN_EMAIL=akashsrivastava626262@gmail.com

# AI Integration (placeholder — connect OpenAI, Claude, or construction APIs)
AI_API_KEY=your_openai_or_claude_api_key
AI_API_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o

# CORS
FRONTEND_URL=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
